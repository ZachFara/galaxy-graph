{
  "name": "obsidian-galaxy-graph",
  "version": "1.0.1",
  "description": "3D force-directed galaxy graph for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "make check",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deadcode": "knip",
    "boundaries": "depcruise main.ts src tests --config .dependency-cruiser.cjs",
    "layout": "node scripts/check-layout.mjs",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "graph",
    "3d"
  ],
  "author": "Zachariah Farahany",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZachFara/galaxy-graph.git"
  },
  "homepage": "https://github.com/ZachFara/galaxy-graph#readme",
  "dependencies": {
    "3d-force-graph": "^1.73.5",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.184.1",
    "dependency-cruiser": "^18.7.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.44.1",
    "obsidian": "latest",
    "prettier": "^3.9.10",
    "tslib": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
